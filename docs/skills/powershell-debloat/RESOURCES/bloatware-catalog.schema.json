{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bloatware Catalog",
  "description": "Catálogo de aplicaciones y paquetes Appx que pueden ser removidas del sistema",
  "type": "object",
  "required": ["version", "updatedAt", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "category",
          "removalStrategy",
          "risk",
          "consequences",
          "reversal",
          "windowsBuilds",
          "requiresElevation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único para el bloatware"
          },
          "displayName": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "consumer-app",
              "ai",
              "ms-core",
              "xbox",
              "media",
              "maps",
              "legacy"
            ]
          },
          "removalStrategy": {
            "type": "string",
            "enum": [
              "appx-allusers",
              "appx-currentuser",
              "provisioned",
              "uninstaller",
              "custom"
            ]
          },
          "packageNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uninstallerIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "customScript": {
            "type": "string"
          },
          "registryKeys": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reversal": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "method": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          },
          "windowsBuilds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiresElevation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
