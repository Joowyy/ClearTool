{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cache Locations Catalog",
  "description": "Catálogo de ubicaciones de caché que pueden ser limpias",
  "type": "object",
  "required": ["version", "updatedAt", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "path",
          "category",
          "requiresAdmin",
          "risk",
          "preconditions",
          "filters",
          "consequences",
          "averageSize"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Ruta con variables de entorno (%TEMP%, %LOCALAPPDATA%, etc.)"
          },
          "category": {
            "type": "string",
            "enum": [
              "user-temp",
              "system-temp",
              "windows-update",
              "logs",
              "browser-cache",
              "app-cache",
              "thumbnails",
              "ccleaner"
            ]
          },
          "requiresAdmin": {
            "type": "boolean"
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filters": {
            "type": "object",
            "properties": {
              "olderThanDays": {
                "type": "integer"
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "averageSize": {
            "type": "string"
          }
        }
      }
    }
  }
}
