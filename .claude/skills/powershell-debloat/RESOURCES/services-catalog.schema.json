{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Services Catalog",
  "description": "Catálogo de servicios Windows que pueden ser gestionados",
  "type": "object",
  "required": ["version", "updatedAt", "presets", "services"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "presets": {
      "type": "object",
      "properties": {
        "TelemetryOff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "XboxOff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "PrintOff": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "FullDebloat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "displayName",
          "category",
          "recommendedAction",
          "riskIfDisabled",
          "consequences"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del servicio en Windows"
          },
          "displayName": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "telemetry",
              "maps",
              "media",
              "consumer",
              "legacy",
              "geolocation",
              "hardware",
              "biometric",
              "input",
              "network",
              "security",
              "search",
              "xbox",
              "print"
            ]
          },
          "recommendedAction": {
            "type": "string",
            "enum": ["disable", "manual", "keep-auto", "remove"]
          },
          "riskIfDisabled": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
